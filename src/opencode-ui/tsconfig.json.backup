{
  "compilerOptions": {
    // === Temel Ayarlar ===
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    
    // === Tip Kontrolü ===
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    
    // === Strict Ayarları ===
    // NOT: Aşamalı strict mode geçişi (2026-01-26)
    // ✅ strictNullChecks: true (33 hata düzeltildi)
    // ⏳ Sonraki adım: noImplicitAny: true (335 hata)
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "noImplicitThis": false,
    "useUnknownInCatchVariables": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    
    // === Import/Export ===
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    
    // === Path Alias ===
    "baseUrl": ".",
    "paths": {
      "@opencode/*": ["js/*"]
    },
    
    // === Diğer ===
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  
  "include": [
    "js/**/*.ts",
    "js/**/*.js",
    "js/**/*.d.ts"
  ],
  
  "exclude": [
    "node_modules"
  ]
}
