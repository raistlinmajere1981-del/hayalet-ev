{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "target": "ESNext",
    "noEmit": true,
    "skipLibCheck": true,
    "checkJs": true,
    "allowJs": true,
    "strict": true,
    "noImplicitThis": true,
    "strictFunctionTypes": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@electron/*": ["electron/*"],
      "@electron/types": ["electron/types/index.ts"]
    }
  },
  "include": [
    "electron/**/*.js",
    "electron/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "electron/preload.cjs",
    "electron/webview-preload.cjs"
  ]
}
