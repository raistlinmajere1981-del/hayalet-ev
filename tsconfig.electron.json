{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "target": "ESNext",
    "noEmit": true,
    "skipLibCheck": true,
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": [
    "electron/**/*.js",
    "electron/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "electron/preload.cjs",
    "electron/webview-preload.cjs"
  ]
}
