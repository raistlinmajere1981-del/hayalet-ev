{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "$lib/*": ["../../.build/gaia-room/openplan3d/src/lib/*"]
    }
  },
  "include": ["Workshop.svelte", "host.d.ts"]
}
