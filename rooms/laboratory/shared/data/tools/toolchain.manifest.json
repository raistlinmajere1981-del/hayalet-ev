          "${roomStorageDir}/runtime/pyaudioanalysis-venv/Scripts/python.exe"
        ],
        "setupHint": "Install pyAudioAnalysis plus its local runtime dependencies (numpy, scipy, scikit-learn, hmmlearn, matplotlib, eyed3, and pydub) on the host system, then refresh this tool from settings."
      },
      "installer": {
        "type": "python-venv-pip",
