    "pyaudioanalysis": {
      "displayName": "pyAudioAnalysis",
      "installDirName": "pyaudioanalysis",
      "availability": "system-command",
      "installStrategy": "manual",
      "usedBy": [
        "Speaker diarization fallback",
        "Segment classification"
      ],
      "testImpact": [
        "speaker-diarization",
        "audio-segmentation"
      ],
      "readinessImpact": "Diarization and segmentation fallback flows stay blocked until the host package is installed.",
      "stageSupport": {
        "source": "unsupported",
        "edit": "unsupported",
        "profile": "optional",
        "process": "optional",
        "report": "unsupported"
      },
      "probe": {
        "args": [
          "-c",
          "from pyAudioAnalysis import audioSegmentation as aS; import hmmlearn, sklearn, scipy, numpy; print('pyAudioAnalysis')"
        ],
