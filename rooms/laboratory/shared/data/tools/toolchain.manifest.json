{
  "version": 1,
  "roomId": "laboratory",
  "tools": {
    "yt-dlp": {
      "displayName": "yt-dlp",
      "installDirName": "yt-dlp",
      "installStrategy": "automatic",
      "usedBy": [
        "Media intake",
        "YouTube capture"
      ],
      "testImpact": [
        "source-routing",
        "youtube-import"
      ],
      "readinessImpact": "Blocks remote YouTube and playlist-based intake flows.",
      "stageSupport": {
        "source": "required",
        "edit": "unsupported",
        "profile": "unsupported",
        "process": "unsupported",
        "report": "unsupported"
      },
      "releaseProvider": {
        "type": "github-release",
        "owner": "yt-dlp",
        "repo": "yt-dlp",
        "releaseUrl": "https://github.com/yt-dlp/yt-dlp/releases/latest"
      },
      "probe": {
        "args": [
          "--version"
        ],
        "versionRegex": "(\\d{4}\\.\\d{2}\\.\\d{2}(?:\\.[0-9]+)?)"
      },
      "assets": {
        "linux-x64": {
          "assetMatch": "^yt-dlp_linux$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "linux-arm64": {
          "assetMatch": "^yt-dlp_linux_aarch64$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "linux-musl-x64": {
          "assetMatch": "^yt-dlp_musllinux$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "darwin-x64": {
          "assetMatch": "^yt-dlp_macos$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "darwin-arm64": {
          "assetMatch": "^yt-dlp_macos$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "win32-x64": {
          "assetMatch": "^yt-dlp\\.exe$",
          "archive": "none",
          "executableName": "yt-dlp.exe"
        },
        "win32-arm64": {
          "assetMatch": "^yt-dlp_arm64\\.exe$",
          "archive": "none",
          "executableName": "yt-dlp.exe"
        }
      }
    },
    "ffmpeg": {
      "displayName": "FFmpeg",
      "installDirName": "ffmpeg",
      "installStrategy": "automatic",
      "usedBy": [
        "Media edit",
        "Profile artifacts",
        "Managed process runs"
      ],
      "testImpact": [
        "media-edit",
        "profile-preflight",
        "managed-reporting"
      ],
      "readinessImpact": "Blocks local transforms, derived outputs, and most managed analysis runs.",
      "stageSupport": {
        "source": "required",
        "edit": "required",
        "profile": "required",
        "process": "required",
        "report": "unsupported"
      },
      "releaseProvider": {
        "type": "github-release",
        "owner": "yt-dlp",
        "repo": "FFmpeg-Builds",
        "releaseUrl": "https://github.com/yt-dlp/FFmpeg-Builds/releases/latest"
      },
      "probe": {
        "args": [
          "-version"
        ],
        "versionRegex": "ffmpeg version\\s+([^\\s]+)"
      },
      "assets": {
        "linux-x64": {
          "assetMatch": "^ffmpeg-master-latest-linux64-gpl\\.tar\\.xz$",
          "archive": "tar.xz",
          "executableName": "ffmpeg",
          "companionExecutables": [
            "ffprobe"
          ]
        },
        "linux-arm64": {
          "assetMatch": "^ffmpeg-master-latest-linuxarm64-gpl\\.tar\\.xz$",
          "archive": "tar.xz",
          "executableName": "ffmpeg",
          "companionExecutables": [
            "ffprobe"
          ]
        },
        "win32-x64": {
          "assetMatch": "^ffmpeg-master-latest-win64-gpl\\.zip$",
          "archive": "zip",
          "executableName": "ffmpeg.exe",
          "companionExecutables": [
            "ffprobe.exe"
          ]
        },
        "win32-arm64": {
          "assetMatch": "^ffmpeg-master-latest-winarm64-gpl\\.zip$",
          "archive": "zip",
          "executableName": "ffmpeg.exe",
          "companionExecutables": [
            "ffprobe.exe"
          ]
        }
      }
    },
    "whisper.cpp": {
      "displayName": "Whisper.cpp",
      "installDirName": "whisper-cpp",
      "availability": "system-command",
      "usedBy": [
        "Transcript extraction",
        "Speech overlay checks"
      ],
      "testImpact": [
        "profile-transcript",
        "speech-overlay"
      ],
      "readinessImpact": "Limits transcript-backed speech checks and transcript artifacts.",
      "manualHint": "Whisper.cpp is managed from the main Settings transcript runtime panel. Laboratory only refreshes and displays the active system/runtime state.",
      "stageSupport": {
        "source": "unsupported",
        "edit": "unsupported",
        "profile": "optional",
        "process": "optional",
        "report": "unsupported"
      },
      "probe": {
        "args": [
          "--help"
        ],
        "versionRegex": "v?(\\d+\\.\\d+\\.\\d+)"
      },
      "systemCommand": {
        "executableName": "whisper-cli",
        "envVarNames": [
          "HAYALET_EV_TRANSCRIPT_WHISPER_BIN"
        ],
        "candidatePaths": [
          "${dataDir}/transcript/whisper.cpp-build/bin/whisper-cli",
          "${dataDir}/transcript/whisper.cpp-build/bin/main",
          "${dataDir}/transcript/whisper.cpp-src/build/bin/whisper-cli",
          "${dataDir}/transcript/whisper.cpp-src/build/bin/main"
        ],
        "setupHint": "Open Settings > User > Speech Runtime, prepare the active runtime there, then refresh this card to re-probe the current system state."
      },
      "manualGuide": {
        "linux": {
          "installCommands": [
            "Settings > User > Speech Runtime > Prepare active runtime"
          ],
          "notes": [
            "Optional overrides such as HAYALET_EV_TRANSCRIPT_WHISPER_BIN still work, but lifecycle ownership stays in Settings."
          ]
        },
        "macos": {
          "installCommands": [
            "Settings > User > Speech Runtime > Prepare active runtime"
          ],
          "notes": [
            "Optional overrides such as HAYALET_EV_TRANSCRIPT_WHISPER_BIN still work, but lifecycle ownership stays in Settings."
          ]
        },
        "windows": {
          "installCommands": [
            "Settings > User > Speech Runtime > Prepare active runtime"
          ],
          "notes": [
            "Optional overrides such as HAYALET_EV_TRANSCRIPT_WHISPER_BIN still work, but lifecycle ownership stays in Settings."
          ]
        }
      }
    },
    "opensmile": {
      "displayName": "openSMILE",
      "installDirName": "opensmile",
      "availability": "installable",
      "installStrategy": "automatic",
      "usedBy": [
        "Prosody checks",
        "Paralinguistic audio features"
      ],
      "testImpact": [
        "audio-prosody",
        "voice-pattern-checks"
      ],
      "readinessImpact": "Optional audio feature extraction stays unavailable until the host binary is installed.",
      "stageSupport": {
        "source": "unsupported",
        "edit": "unsupported",
        "profile": "optional",
        "process": "optional",
        "report": "unsupported"
      },
      "probe": {
        "args": [
          "-h"
        ],
        "versionRegex": "(?:openSMILE|SMILExtract)[^\\d]*(\\d+(?:\\.\\d+)+)"
      },
      "releaseProvider": {
        "type": "github-release",
        "owner": "audeering",
        "repo": "opensmile",
        "releaseUrl": "https://github.com/audeering/opensmile/releases/latest"
      },
      "assets": {
        "linux-x64": {
          "assetMatch": "^opensmile-.*-linux-x86_64\\.zip$",
          "archive": "zip",
          "executableName": "SMILExtract",
          "companionExecutables": [
            "libSMILEapi.so"
          ]
        },
        "linux-arm64": {
          "assetMatch": "^opensmile-.*-linux-armv8\\.zip$",
          "archive": "zip",
          "executableName": "SMILExtract",
          "companionExecutables": [
            "libSMILEapi.so"
          ]
        },
        "darwin-x64": {
          "assetMatch": "^opensmile-.*-macos-x86_64\\.zip$",
          "archive": "zip",
          "executableName": "SMILExtract",
          "companionExecutables": [
            "libSMILEapi.dylib"
          ]
        },
        "darwin-arm64": {
          "assetMatch": "^opensmile-.*-macos-armv8\\.zip$",
          "archive": "zip",
          "executableName": "SMILExtract",
          "companionExecutables": [
            "libSMILEapi.dylib"
          ]
        },
        "win32-x64": {
          "assetMatch": "^opensmile-.*-windows-x86_64\\.zip$",
          "archive": "zip",
          "executableName": "SMILExtract.exe",
          "companionExecutables": [
            "SMILEapi.dll"
          ]
        }
      },
      "systemCommand": {
        "executableName": "SMILExtract",
        "setupHint": "Use the in-app install on supported runtimes, or install openSMILE on the host system so the SMILExtract binary is available on PATH, then refresh this tool from settings."
      },
      "manualGuide": {
        "linux": {
          "notes": [
            "If this runtime does not expose an in-app binary, install an openSMILE build for your distro and ensure SMILExtract is available on PATH."
          ]
        },
        "macos": {
          "notes": [
            "If this runtime does not expose an in-app binary, install openSMILE from a host package or local build, then expose SMILExtract on PATH."
          ]
        },
        "windows": {
          "notes": [
            "If this runtime does not expose an in-app binary, install the openSMILE host build and make sure SMILExtract.exe is available on PATH."
          ]
        }
      }
    },
    "yamnet": {
      "displayName": "YAMNet",
      "installDirName": "yamnet",
      "availability": "system-command",
      "installStrategy": "manual",
      "usedBy": [
        "Sound event tagging",
        "Ambient event summaries"
      ],
      "testImpact": [
        "audio-events",
        "environmental-audio"
      ],
      "readinessImpact": "Event tagging and ambient sound summaries remain disabled without the Python runtime.",
      "stageSupport": {
        "source": "unsupported",
        "edit": "unsupported",
        "profile": "optional",
        "process": "optional",
        "report": "unsupported"
      },
      "probe": {
        "args": [
          "-c",
          "import tensorflow as tf, tensorflow_hub as hub, scipy, numpy; print(tf.__version__)"
        ],
        "versionRegex": "(\\d+(?:\\.\\d+)+)"
      },
      "systemCommand": {
        "executableName": "python3",
        "candidatePaths": [
          "${roomStorageDir}/runtime/yamnet-venv/bin/python3",
          "${roomStorageDir}/runtime/yamnet-venv/bin/python",
          "${roomStorageDir}/runtime/yamnet-venv/Scripts/python.exe"
        ],
        "setupHint": "Install python3 packages tensorflow, tensorflow_hub, numpy, scipy, and setuptools<81 so the room-local YAMNet helper can run, then refresh this tool from settings."
      },
      "installer": {
        "type": "python-venv-pip",
        "venvDir": "${roomStorageDir}/runtime/yamnet-venv",
        "packages": [
          "tensorflow",
          "tensorflow_hub",
          "numpy",
          "scipy",
          "setuptools<81"
        ]
      },
      "manualGuide": {
        "linux": {
          "installCommands": [
            "python3 -m pip install tensorflow tensorflow_hub numpy scipy 'setuptools<81'"
          ]
        },
        "macos": {
          "installCommands": [
            "python3 -m pip install tensorflow tensorflow_hub numpy scipy 'setuptools<81'"
          ]
        },
        "windows": {
          "installCommands": [
            "py -m pip install tensorflow tensorflow_hub numpy scipy \"setuptools<81\""
          ]
        }
      }
    },
