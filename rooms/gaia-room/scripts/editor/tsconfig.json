{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": {
      "$lib/*": ["../../../.build/gaia-room/openplan3d/src/lib/*"]
    },
    "resolveJsonModule": true
  },
  "include": ["Room.svelte", "Workshop.svelte", "host.d.ts"]
}
