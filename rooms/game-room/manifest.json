      "icon": "XO",
      "commandSpecs": [
        {
          "name": "GameRoomXoxStart",
          "description": "Start a new XOX match from the room UI.",
          "scope": "room-ui"
        },
        {
          "name": "GameRoomXoxReset",
          "description": "Reset the active XOX match state.",
          "scope": "room-ui"
        },
        {
          "name": "GameRoomXoxUserMove",
          "description": "Apply the user's XOX move from the room UI.",
          "scope": "room-ui"
        },
        {
          "name": "GameRoomXoxAiMove",
          "description": "Apply the AI move returned by the selected opponent slot.",
          "scope": "ai-slots"
        },
        {
          "name": "GameRoomXoxRemoteMove",
          "description": "Apply the remote US1 move delivered over room mail transport.",
          "scope": "us1"
        },
        {
          "name": "GameRoomXoxAcceptInvite",
          "description": "Accept an incoming US1 XOX invite from the room UI.",
          "scope": "room-ui"
        },
        {
          "name": "GameRoomXoxRejectInvite",
          "description": "Reject an incoming US1 XOX invite from the room UI.",
          "scope": "room-ui"
        }
      ],
