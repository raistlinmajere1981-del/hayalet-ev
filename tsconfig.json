{
  "compilerOptions": {
    // === Temel Ayarlar ===
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    
    // === Tip Kontrolü ===
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    
    // === Strict Ayarları (Kademeli Açılacak) ===
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    
    // === Import/Export ===
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    
    // === Path Alias ===
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@electron/*": ["electron/*"]
    },
    
    // === Diğer ===
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  
  // === Renderer Process (src/js) ===
  "include": [
    "src/js/**/*.js",
    "src/js/**/*.ts",
    "src/js/**/*.d.ts"
  ],
  
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "electron",
    "mcp-server",
    ".rovodev"
  ]
}
