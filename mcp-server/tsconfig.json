{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "checkJs": false,
    "allowJs": false,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": [
    "index.ts",
    "tools/*.ts",
    "utils/*.ts",
    "types/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
