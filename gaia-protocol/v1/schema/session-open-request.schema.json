{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": { "type": "number", "const": 1 },
    "projectId": {
      "type": "string",
      "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9]|constructor|prototype)$)[a-z0-9][a-z0-9-]{0,63}$"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9]|constructor|prototype)$)[a-z0-9][a-z0-9-]{0,63}$"
    },
    "installationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "offered": {
      "maxItems": 32,
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,95}$" },
      "uniqueItems": true
    }
  },
  "required": ["v", "projectId", "deviceId", "installationId", "runId", "offered"],
  "additionalProperties": false,
  "title": "Gaia v1 session open request",
  "description": "POST /gaia/v1/sessions. offered may contain unknown but syntactically valid ids."
}
