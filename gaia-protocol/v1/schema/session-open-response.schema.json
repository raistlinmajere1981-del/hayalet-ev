{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": { "type": "number", "const": 1 },
    "sessionId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "accepted": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "battery.level.v1",
          "battery.pack-temperature.v1",
          "battery.voltage.v1",
          "battery.charge-state.v1",
          "accelerometer.xyz.v1",
          "proximity.state.v1",
          "network.state.v1",
          "signal.read.v1"
        ]
      },
      "uniqueItems": true
    },
    "intervalMs": { "type": "number", "const": 10000 },
    "timeoutMs": { "type": "number", "const": 35000 }
  },
  "required": ["v", "sessionId", "accepted", "intervalMs", "timeoutMs"],
  "additionalProperties": false,
  "title": "Gaia v1 session open response",
  "description": "201 response. accepted is a unique subset of offered and the v1 field catalog."
}
