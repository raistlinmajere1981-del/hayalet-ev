{
  "name": "app",
  "version": "5.4.0",
  "description": "Hayalet Ev - İnsan ve AI arasında kolektif zihin platformu",
  "main": "dist/electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:all": "npm run build && npm run electron:build && npm run mcp:build && npm run ghost:build:all",
    "dist:win:prepare": "npm run build:all && npm run better-sqlite3:prepare:electron && npm run libsql:prepare:win && npm run vosk-koffi:prepare:all",
    "dist:win": "npm run dist:win:prepare && electron-builder --config electron-builder.yml --win",
    "dist:win:portable": "npm run dist:win:prepare && electron-builder --config electron-builder.yml --win portable",
    "dist:win:zip": "npm run dist:win:prepare && electron-builder --config electron-builder.yml --win zip",
    "dist:linux": "npm run build:all && npm run better-sqlite3:prepare:electron && npm run vosk-koffi:prepare && electron-builder --config electron-builder.yml --linux AppImage",
    "dist:all": "npm run dist:win && npm run dist:linux",
    "better-sqlite3:status": "node scripts/better-sqlite3-runtime.mjs status",
    "better-sqlite3:prepare:node": "node scripts/better-sqlite3-runtime.mjs prepare-node",
    "better-sqlite3:prepare:electron": "node scripts/better-sqlite3-runtime.mjs prepare-electron",
    "libsql:prepare:win": "node scripts/prepare-libsql-win-runtime.mjs",
    "vosk-koffi:prepare": "node scripts/prepare-vosk-koffi-runtime.mjs",
    "vosk-koffi:prepare:all": "node scripts/prepare-vosk-koffi-runtime.mjs --ignore-platform",
    "better-sqlite3:activate:node": "node scripts/better-sqlite3-runtime.mjs activate node",
    "better-sqlite3:activate:electron": "node scripts/better-sqlite3-runtime.mjs activate electron",
    "rebuild": "npm run better-sqlite3:prepare:electron",
    "postinstall": "npm run rebuild",
    "preview": "vite preview",
    "electron": "electron . --no-sandbox",
    "electron:build": "esbuild electron/main.ts --bundle --platform=node --packages=external --tsconfig=electron/tsconfig.electron.json --outfile=dist/electron/main.js --format=esm && esbuild electron/packaged-wrapper-main.ts --bundle --platform=node --packages=external --tsconfig=electron/tsconfig.electron.json --outfile=dist/electron/packaged-wrapper-main.js --format=esm && esbuild electron/packaged-wrapper-cli.ts --bundle --platform=node --packages=external --tsconfig=electron/tsconfig.electron.json --outfile=dist/electron/packaged-wrapper-cli.js --format=esm && mkdir -p dist/electron/provider-tester && esbuild electron/provider-tester/index.ts --bundle --platform=node --packages=external --tsconfig=electron/tsconfig.electron.json --outfile=dist/electron/provider-tester/index.js --format=esm && cp electron/preload.cjs electron/webview-preload.cjs electron/room-webview-preload.cjs dist/electron/",
    "electron:assistant": "npm run electron:build && concurrently -k -s first \"vite\" \"wait-on http://localhost:5174 && CDP_PORT=9222 electron ./dist/electron/main.js --no-sandbox --start-page=assistant --auto-connect\"",
    "electron:assistant:scene": "npm run electron:build && concurrently -k -s first \"vite\" \"wait-on http://localhost:5174 && CDP_PORT=9222 electron ./dist/electron/main.js --no-sandbox --start-page=assistant --auto-connect --ui-mode=scene\"",
    "electron:dev": "npm run electron:build && concurrently -k -s first \"vite\" \"wait-on http://localhost:5174 && CDP_PORT=9222 electron ./dist/electron/main.js --no-sandbox\"",
    "electron:dev:scene": "npm run electron:build && concurrently -k -s first \"vite\" \"wait-on http://localhost:5174 && CDP_PORT=9222 electron ./dist/electron/main.js --no-sandbox --ui-mode=scene\"",
    "electron:dev:scene:debug": "npm run electron:build && concurrently -k -s first \"vite\" \"wait-on http://localhost:5174 && CDP_PORT=9222 electron ./dist/electron/main.js --no-sandbox --ui-mode=scene --scene-debug\"",
    "electron:dev:assistant": "npm run electron:build && concurrently -k -s first \"vite\" \"wait-on http://localhost:5174 && CDP_PORT=9222 electron ./dist/electron/main.js --no-sandbox --start-page=assistant --auto-connect\"",
    "electron:dev:assistant:scene": "npm run electron:build && concurrently -k -s first \"vite\" \"wait-on http://localhost:5174 && CDP_PORT=9222 electron ./dist/electron/main.js --no-sandbox --start-page=assistant --auto-connect --ui-mode=scene\"",
    "electron:dev:assistant:scene:debug": "npm run electron:build && concurrently -k -s first \"vite\" \"wait-on http://localhost:5174 && CDP_PORT=9222 electron ./dist/electron/main.js --no-sandbox --start-page=assistant --auto-connect --ui-mode=scene --scene-debug\"",
    "start": "node scripts/ghost-agent-wrapper.mjs",
    "start:scene": "APP_UI_MODE=scene node scripts/ghost-agent-wrapper.mjs",
    "start:scene:debug": "APP_UI_MODE=scene APP_SCENE_DEBUG=1 node scripts/ghost-agent-wrapper.mjs",
    "start:ghost": "node scripts/ghost-agent-wrapper.mjs --ghost-only",
    "ghost:build": "node scripts/build-ghost-agent.mjs",
    "ghost:electron:build": "esbuild ghost-agent/electron/main.ts --bundle --platform=node --packages=external --tsconfig=ghost-agent/tsconfig.electron.json --outfile=dist/ghost-agent/electron/main.js --format=esm && cp ghost-agent/electron/preload.cjs dist/ghost-agent/electron/",
    "ghost:build:all": "npm run ghost:build && npm run ghost:electron:build",
    "android:check": "node scripts/check-android-companion.mjs",
    "android:build": "node scripts/build-android-companion.mjs --bootstrap",
    "android:install": "node scripts/install-android-companion.mjs",
    "android:update": "node scripts/install-android-companion.mjs",
    "android:deps:check": "node scripts/update-android-companion-deps.mjs --check",
    "android:deps:update": "node scripts/update-android-companion-deps.mjs",
    "android:open": "node scripts/open-android-companion.mjs",
    "ghost:dev": "npm run ghost:build:all && CDP_PORT=9222 electron ./dist/ghost-agent/electron/main.js --no-sandbox",
    "ghost:start": "npm run ghost:build:all && electron ./dist/ghost-agent/electron/main.js --no-sandbox",
    "ghost:handoff": "npm run ghost:build:all && npm run electron:build && node scripts/ghost-agent-wrapper.mjs",
    "whereami": "node scripts/whereami.mjs",
    "whereami:mode": "node scripts/whereami.mjs --mode-only",
    "assistant:profile": "node scripts/assistant-session-profile.mjs",
    "intel:setup": "node scripts/assistant-intel.mjs setup",
    "intel:index": "node scripts/assistant-intel.mjs index .",
    "intel:projects": "node scripts/assistant-intel.mjs projects",
    "intel:schema": "node scripts/assistant-intel.mjs schema .",
    "intel:search": "node scripts/assistant-intel.mjs search",
    "intel:trace": "node scripts/assistant-intel.mjs trace",
    "intel:changes": "node scripts/assistant-intel.mjs changes .",
    "mode:status": "node scripts/transition.mjs status",
    "mode:wait": "node scripts/transition.mjs wait",
    "mode:trigger": "node scripts/transition.mjs trigger",
    "mode:switch": "node scripts/transition.mjs switch",
    "clean": "rm -rf dist .vite node_modules/.vite",
    "clean:logs": "rm -rf logs/*",
    "clean:all": "npm run clean && npm run clean:logs",
    "mcp:start": "node mcp-server/start.js",
    "mcp:build": "node scripts/build-mcp-server.mjs",
    "mcp:test": "node mcp-server/start.js --version",
    "mcp:check": "tsc --noEmit -p mcp-server/tsconfig.mcp.json && eslint \"mcp-server/**/*.ts\"",
    "mcp:lint": "eslint \"mcp-server/**/*.ts\"",
    "mcp:lint:fix": "eslint --fix \"mcp-server/**/*.ts\"",
    "lint": "NODE_OPTIONS=\"--max-old-space-size=4096\" eslint --cache --cache-location node_modules/.cache/eslint \"src/**/*.{js,ts}\" \"electron/**/*.{ts,cjs}\" \"ghost-agent/**/*.{ts,cjs}\" \"rooms/**/*.{js,ts}\"",
    "lint:fix": "NODE_OPTIONS=\"--max-old-space-size=4096\" eslint --cache --cache-location node_modules/.cache/eslint \"src/**/*.{js,ts}\" \"electron/**/*.{ts,cjs}\" \"ghost-agent/**/*.{ts,cjs}\" \"rooms/**/*.{js,ts}\" --fix",
    "design:audit": "node scripts/design-system-audit.mjs",
    "design:audit:rooms": "node scripts/design-system-audit.mjs --scope=rooms --no-baseline",
    "format": "prettier --write \"src/**/*.{js,ts,css,html,json,md}\" \"electron/**/*.{ts,cjs}\" \"ghost-agent/**/*.{ts,css,html,cjs}\" \"rooms/**/*.{js,ts,css,html,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,css,html,json,md}\" \"electron/**/*.{ts,cjs}\" \"ghost-agent/**/*.{ts,css,html,cjs}\" \"rooms/**/*.{js,ts,css,html,json,md}\"",
    "check": "npm run lint && npm run check-types && npm run rooms:test:core",
    "check:all": "npm run format:check && npm run lint && npm run check-types && npm run test:all && npm run design:audit && npm run design:audit:rooms && npm run deps:check && npm run rooms:build && npm run build:all",
    "check:all:fix": "npm run format && npm run check:all",
    "deps:check": "depcruise src electron ghost-agent rooms --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit -p src/tsconfig.json && tsc --noEmit -p electron/tsconfig.electron.json && tsc --noEmit -p mcp-server/tsconfig.mcp.json && tsc --noEmit -p ghost-agent/tsconfig.json && tsc --noEmit -p ghost-agent/tsconfig.electron.json && tsc --noEmit -p rooms/tsconfig.rooms.json",
    "pre-commit": "node scripts/pre-commit.js",
    "check-types": "npm run typecheck",
    "knip": "knip",
    "knip:strict": "knip --include files,dependencies,devDependencies,unlisted,exports,types,duplicates",
    "knip:fix": "knip --fix",
    "knip:watch": "knip --watch",
    "test:all": "TSX_TSCONFIG_PATH=src/tsconfig.json node scripts/tests/run-all-tests.mjs",
    "test:smoke": "node scripts/smoke-test.js",
    "test:smoke:auto": "node scripts/smoke-test.js --auto-start",
    "test:smoke:.verbose": "node scripts/smoke-test.js --verbose --screenshot",
    "mail:transport:smoke": "npx tsx scripts/mail-transport-smoke.ts",
    "us1:relay:start": "npx tsx scripts/us1-relay-server.ts",
    "drive-push": "node scripts/sync-to-drive.js",
    "update": "npm run update:deps && npm run android:deps:update",
    "update:check": "npx npm-check-updates --peer && npm run android:deps:check",
    "update:safe": "npx npm-check-updates -u --target minor && npm install",
    "update:deps": "npx npm-check-updates -u --reject electron,electron-builder && npm install",
    "update:full": "npx npm-check-updates -u --reject electron && npm install",
    "update:interactive": "npx npm-check-updates -i --format group",
    "rooms:bundle": "TSX_TSCONFIG_PATH=src/tsconfig.json node --import tsx scripts/rooms/build-room-bundle.mjs",
    "rooms:build": "TSX_TSCONFIG_PATH=src/tsconfig.json node --import tsx scripts/rooms/build-workspace-rooms.ts",
    "rooms:paths": "TSX_TSCONFIG_PATH=src/tsconfig.json node --import tsx scripts/rooms/report-room-paths.ts",
    "rooms:clean-generated": "TSX_TSCONFIG_PATH=src/tsconfig.json node --import tsx scripts/rooms/clean-generated-room-artifacts.ts",
    "laboratory:cleanup:inventory": "TSX_TSCONFIG_PATH=src/tsconfig.json node --import tsx rooms/laboratory/scripts/laboratory-cleanup-inventory.ts",
    "laboratory:cleanup:gate": "TSX_TSCONFIG_PATH=src/tsconfig.json node --import tsx rooms/laboratory/scripts/laboratory-dead-code-gate.ts --fail-on-findings",
    "rooms:test:file": "TSX_TSCONFIG_PATH=src/tsconfig.json node --import tsx --import ./scripts/tests/register-asset-loader.mjs --test --test-concurrency=1",
    "rooms:test:core": "TSX_TSCONFIG_PATH=src/tsconfig.json node --import tsx --test scripts/tests/room-package-boundary-regressions.test.ts scripts/tests/room-bundle-import-regressions.test.ts scripts/tests/room-package-manager-bootstrap-regressions.test.ts scripts/tests/room-workspace-build-regressions.test.ts scripts/tests/room-manifest-regressions.test.ts scripts/tests/room-command-registry-regressions.test.ts scripts/tests/room-protocol-registry-regressions.test.ts scripts/tests/room-overlay-regressions.test.ts scripts/tests/room-page-regressions.test.ts scripts/tests/room-ui-regressions.test.ts scripts/tests/rooms-scene-page-regressions.test.ts scripts/tests/room-host-source-regressions.test.ts scripts/tests/room-layout-migration-regressions.test.ts scripts/tests/room-layout-contract-regressions.test.ts scripts/tests/laboratory-host-import-smoke-regressions.test.ts scripts/tests/game-room-host-import-smoke-regressions.test.ts scripts/tests/game-room-installed-host-runtime-smoke-regressions.test.ts scripts/tests/game-room-installed-ui-smoke-regressions.test.ts scripts/tests/laboratory-host-action-runtime-regressions.test.ts scripts/tests/laboratory-media-edit-installed-parity-regressions.test.ts scripts/tests/laboratory-media-profile-installed-parity-regressions.test.ts scripts/tests/scene-debug-room-regressions.test.ts scripts/tests/repair-room-runtime-regressions.test.ts scripts/tests/repair-room-overlay-regressions.test.ts scripts/tests/repair-room-host-import-smoke-regressions.test.ts scripts/tests/forge-room-manifest-regressions.test.ts scripts/tests/forge-room-breakdown-runtime-regressions.test.ts scripts/tests/forge-room-task-runtime-regressions.test.ts scripts/tests/forge-room-task-editor-runtime-regressions.test.ts scripts/tests/forge-room-synthesis-runtime-regressions.test.ts scripts/tests/forge-room-host-runtime-flow-regressions.test.ts scripts/tests/forge-room-install-sync-regressions.test.ts scripts/tests/forge-room-host-import-smoke-regressions.test.ts scripts/tests/forge-room-installed-ui-smoke-regressions.test.ts scripts/tests/forge-room-session-storage-regressions.test.ts scripts/tests/forge-room-preflight-v2-regressions.test.ts scripts/tests/forge-room-handoff-guard-regressions.test.ts scripts/tests/pattern-room-source-workbench-regressions.test.ts scripts/tests/pattern-room-source-producer-regressions.test.ts scripts/tests/pattern-room-source-producer-orchestration-regressions.test.ts scripts/tests/pattern-room-source-import-apply-regressions.test.ts scripts/tests/pattern-room-host-import-smoke-regressions.test.ts scripts/tests/pattern-room-installed-ui-smoke-regressions.test.ts scripts/tests/pattern-room-session-snapshot-regressions.test.ts scripts/tests/pattern-room-storage-contract-regressions.test.ts scripts/tests/pattern-room-persistence-host-wiring-regressions.test.ts",
    "rooms:check": "npm run rooms:typecheck && npm run rooms:lint && npm run rooms:test:core",
    "rooms:lint": "NODE_OPTIONS=\"--max-old-space-size=4096\" eslint --cache --cache-location node_modules/.cache/eslint \"rooms/**/*.{js,ts}\"",
    "rooms:lint:strict": "NODE_OPTIONS=\"--max-old-space-size=4096\" eslint --cache --cache-location node_modules/.cache/eslint \"rooms/**/*.{js,ts}\" --max-warnings 0",
    "rooms:lint:any": "NODE_OPTIONS=\"--max-old-space-size=4096\" npx eslint --plugin @typescript-eslint \"rooms/**/*.{js,ts}\" --rule '{\"@typescript-eslint/no-explicit-any\":\"error\"}'",
    "rooms:any:count": "rg -n \"\\\\bany\\\\b\" rooms -g '*.ts' | wc -l",
    "rooms:typecheck": "tsc --noEmit -p rooms/tsconfig.rooms.json",
    "rooms:typecheck:null": "tsc --noEmit -p rooms/tsconfig.rooms.json --strictNullChecks",
    "rooms:typecheck:call-strict": "tsc --noEmit -p rooms/tsconfig.rooms.json --strictNullChecks --noImplicitThis --strictFunctionTypes --strictBindCallApply --strictPropertyInitialization",
    "rooms:typecheck:shape": "tsc --noEmit -p rooms/tsconfig.rooms.json --strictNullChecks --exactOptionalPropertyTypes --noUncheckedIndexedAccess",
    "rooms:typecheck:index-signature": "tsc --noEmit -p rooms/tsconfig.rooms.json --strictNullChecks --exactOptionalPropertyTypes --noUncheckedIndexedAccess --noPropertyAccessFromIndexSignature",
    "ai:check": "npm run check",
    "ai:fix": "npm run lint:fix",
    "ai:errors": "tsc --noEmit -p src/tsconfig.json --pretty 2>&1 | grep 'error TS'",
    "ai:stats": "tsc --noEmit -p src/tsconfig.json 2>&1 | tail -1",
    "type:watch": "tsc --noEmit --watch -p src/tsconfig.json",
    "type:watch:electron": "tsc --noEmit --watch -p electron/tsconfig.electron.json"
  },
  "keywords": [
    "electron",
    "ai",
    "chatgpt",
    "grok"
  ],
  "author": "Raistlin, Nexa, Gök",
