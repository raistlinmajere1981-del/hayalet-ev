{
  "name": "hayalet-ev",
  "version": "5.4.0",
  "description": "Hayalet Ev - İnsan ve AI arasında kolektif zihin platformu",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "LIBVA_DRIVER_NAME=i965 electron . --no-sandbox 2>&1 | grep -v 'xapp-gtk3-module'",
    "electron:build": "esbuild electron/main.ts --bundle --platform=node --packages=external --outfile=dist-electron/main.js --format=esm && cp electron/preload.cjs electron/webview-preload.cjs dist-electron/",
    "electron:dev": "npm run electron:build && concurrently -k -s first \"vite\" \"wait-on http://localhost:5173 && CDP_PORT=9223 LIBVA_DRIVER_NAME=i965 electron ./dist-electron/main.js --no-sandbox 2>&1 | grep -v 'xapp-gtk3-module'\"",
    "start": "npm run electron:dev",
    "lint": "eslint \"src/js/**/*.{js,ts}\" \"electron/**/*.ts\" \"electron/**/*.cjs\" \"mcp-server/**/*.ts\"",
    "lint:fix": "eslint \"src/js/**/*.{js,ts}\" \"electron/**/*.ts\" \"electron/**/*.cjs\" \"mcp-server/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{js,css,html,json,md}\"",
    "check": "npm run lint && npm run check-types",
    "check:all": "npm run check && npm run build",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p mcp-server/tsconfig.json",
    "test:smoke": "node .rovodev/scripts/smoke-test.js",
    "test:smoke:auto": "node .rovodev/scripts/smoke-test.js --auto-start",
    "test:smoke:verbose": "node .rovodev/scripts/smoke-test.js --verbose --screenshot",
    "pre-commit": "node .rovodev/scripts/pre-commit.js",
    "edit-lines": "node .rovodev/scripts/edit-lines.js",
    "file": "node .rovodev/scripts/file-ops.js",
    "lint:unused": "node .rovodev/scripts/find-unused.js",
    "analyze": "node .rovodev/scripts/analyze-project.js",
    "analyze:json": "node .rovodev/scripts/analyze-project.js --json",
    "diagram": "node .rovodev/scripts/generate-diagram.js",
    "diagram:simple": "node .rovodev/scripts/generate-diagram.js --simplified",
    "bootstrap": "node .rovodev/scripts/bootstrap-session.js",
    "cache:update": "node .rovodev/scripts/update-cache.js",
    "cache:show": "node .rovodev/scripts/update-cache.js --show",
    "git-sync": "git add . && git commit -m \"Sync\" && git push",
    "git-status": "git status",
    "git-diff": "git diff",
    "drive-push": "node .rovodev/scripts/sync-to-drive.js",
    "update:check": "npx npm-check-updates",
    "update:safe": "npx npm-check-updates -u --target minor && npm install",
    "update:deps": "npx npm-check-updates -u --reject electron,electron-builder && npm install",
    "update:full": "npx npm-check-updates -u && npm install",
    "update:interactive": "npx npm-check-updates -i --format group"
  },
  "keywords": [
    "electron",
    "ai",
    "chatgpt",
    "grok"
  ],
  "author": "Raistlin, Nexa, Gök",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.9",
    "@types/screenshot-desktop": "^1.15.0",
    "concurrently": "^9.2.1",
    "depcheck": "^1.4.7",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "googleapis": "^170.0.0",
    "screenshot-desktop": "^1.15.3"
  }
}
