    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.0",
    "@types/screenshot-desktop": "^1.15.0",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "concurrently": "^9.2.1",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^17.4.0",
    "electron": "^41.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-formatter-compact": "^9.0.1",
    "knip": "^6.13.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "typescript-language-server": "^5.2.0",
    "vite": "^8.0.13",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@imgly/background-removal-node": "^1.4.5",
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/jscodeshift": "^17.3.0",
    "@typescript-eslint/typescript-estree": "^8.59.3",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "duck-duck-scrape": "^2.2.7",
    "esbuild": "^0.28.0",
    "fs-extra": "^11.3.5",
    "glob": "^13.0.6",
    "googleapis": "^171.4.0",
    "gsap": "^3.15.0",
    "imapflow": "^1.3.3",
    "jimp": "^1.6.1",
    "jscodeshift": "^17.3.0",
    "konva": "10.3.0",
    "mailparser": "^3.9.8",
    "node-abi": "^4.31.0",
    "nodemailer": "^8.0.7",
    "screenshot-desktop": "^1.15.4",
    "sharp": "^0.34.5",
    "vosk-koffi": "^1.1.1",
    "ws": "^8.20.1",
    "yauzl": "^3.3.0",
    "zod": "^4.4.3"
  }
}
