{
  "schemaVersion": 1,
  "project": {
    "required": [
      "schemaVersion",
      "id",
      "slug",
      "name",
      "createdAt",
      "updatedAt",
      "source",
      "edit",
      "profile",
      "audioAnalysis",
      "subtitleAnalysis",
      "process",
      "report"
    ],
    "optional": ["workbench"],
    "workbench": {
      "required": [
        "schemaVersion",
        "experienceId",
        "mode",
        "primaryFeatureId",
        "activeModuleId",
        "availableModuleIds",
        "selectedModuleIds"
      ],
      "optional": [
        "analysisScope",
        "moduleToggles",
        "activePreviewArtifactId",
        "activeLiveFindingsStreamId",
        "controlsCollapsed"
      ]
    },
    "source": {
      "required": ["kind", "mode", "status", "drafts"],
      "optional": [
        "storedPath",
        "storedFileName",
        "sourceUrl",
        "mimeType",
        "routeLabel",
        "lastError",
        "metadata",
        "metadataError"
      ],
      "kinds": ["video", "audio", "image"],
      "videoModes": ["youtube", "local", "url"],
      "audioModes": ["local", "url"],
      "imageModes": ["local", "url"],
      "metadata": {
        "optional": [
          "durationSeconds",
          "width",
          "height",
          "codec",
          "videoCodec",
          "audioCodec",
          "formatName",
          "bitRate",
          "sizeBytes",
          "streamCount",
          "mimeType",
          "extractedBy",
          "extractedAt"
        ]
      }
    },
    "edit": {
      "required": [
        "mode",
        "dirty",
        "activePresetId",
        "activeOutputId",
        "handoffMode",
        "preview",
        "recipe",
        "outputs"
      ],
      "optional": ["lastError", "lastActionAt"],
      "modes": ["beginner", "advanced"],
      "handoffModes": ["source", "derived"],
      "preview": {
        "required": ["status", "outputId"],
        "optional": [
          "jobId",
          "requestId",
          "path",
          "fileName",
          "mimeType",
          "metadata",
          "artifacts",
          "error",
          "recipeSignature",
          "updatedAt"
        ]
      },
      "recipe": {
        "required": ["common", "video", "audio", "image"],
        "common": {
          "required": [
            "focusRegionId",
            "cropNormalized",
            "redactionBoxes",
            "outputNameHint",
            "notes"
          ]
        },
        "video": {
          "required": [
            "trimEnabled",
            "trimStartSeconds",
            "trimEndSeconds",
            "resizePreset",
            "customWidth",
            "customHeight",
            "fpsLimit",
            "includeAudio",
            "blurFocusOutside"
          ],
          "optional": ["frameGrabCount"]
        },
        "audio": {
          "required": [
            "trimEnabled",
            "trimStartSeconds",
            "trimEndSeconds",
            "silenceTrim",
            "normalize",
            "normalizeTargetDb",
            "mono",
            "spectrogram",
            "highpassHz",
            "lowpassHz"
          ]
        },
        "image": {
          "required": [
            "rotateDegrees",
            "resizePreset",
            "customWidth",
            "customHeight",
            "brightness",
            "contrast",
            "sharpen",
            "blurStrength"
          ]
        }
      },
      "outputs": {
        "item": {
          "required": [
            "id",
            "kind",
            "path",
            "fileName",
            "mimeType",
            "createdAt",
            "recipeSignature",
            "metadata"
          ],
          "optional": ["label", "jobId", "sourcePath", "artifacts"]
        }
      }
    },
    "profile": {
      "required": [
        "mode",
        "dirty",
        "activePresetId",
        "targetAssetMode",
        "targetOutputId",
        "targetAssetSignature",
        "depth",
        "sensitivity",
        "frameSampleDensity",
        "transcriptSampleSeconds",
        "modelId",
        "artifactPreferences",
        "laneSelection",
        "readiness",
        "estimate",
        "preflight",
        "signals",
        "artifacts"
      ],
      "optional": ["lastError", "lastActionAt"],
      "modes": ["beginner", "advanced"],
      "targetAssetModes": ["source", "derived"],
      "depthModes": ["quick", "balanced", "deep"],
      "frameSampleDensityModes": ["sparse", "balanced", "dense"],
      "artifactPreferences": {
        "required": ["metadata", "frame-strip", "spectrogram", "transcript"]
      },
      "laneSelection": {
        "required": [
          "metadata-lineage",
          "visual-tamper",
          "audio-tamper",
          "speech-overlay",
          "synthetic-suspicion"
        ]
      },
      "readiness": {
        "required": ["stageReady", "requiredTools", "optionalTools", "models", "blockers", "warnings"]
      },
      "estimate": {
        "required": ["runtimeSeconds", "artifactCount", "sampleWindowSeconds"]
      },
      "preflight": {
        "required": ["status", "jobId", "requestId", "ranAt", "targetSummary", "warnings"],
        "optional": ["error"]
      },
      "signals": {
        "item": {
          "required": ["id", "laneId", "kind", "level", "confidence", "title", "detail", "evidenceCount"],
          "optional": ["artifactIds"]
        }
      },
      "artifacts": {
        "item": {
          "required": ["id", "kind", "path", "fileName", "createdAt"],
          "optional": ["label", "metadata"]
        }
      }
    },
    "audioAnalysis": {
      "required": [
        "schemaVersion",
        "source",
        "analysisCatalog",
        "capabilityState",
        "providerState",
        "runs",
        "results",
        "export"
      ],
      "source": {
        "required": [
          "preferredSourceKind",
          "requestedMode",
          "mode",
          "targetSignature"
        ],
        "optional": [
          "outputId",
          "targetPath",
          "targetFileName",
          "targetMimeType",
          "targetLabel",
          "extractedAudioPath",
          "updatedAt"
        ]
      },
      "analysisCatalog": {
        "required": [
          "orderedIds",
          "implementedIds",
          "gatedIds",
          "plannedIds",
          "visibleIds"
        ]
      },
      "capabilityState": {
        "item": {
          "required": [
            "moduleId",
            "phase",
            "status",
            "providerIds",
            "toolIds",
            "blockers",
            "warnings"
          ],
          "optional": ["titleKey", "summaryKey", "requiredToolIds"]
        }
      },
      "providerState": {
        "item": {
          "required": [
            "providerId",
            "status",
            "moduleIds",
            "installed",
            "ready",
            "busy",
            "platformSupported",
            "blockers",
            "warnings"
          ],
          "optional": [
            "toolId",
            "titleKey",
            "summaryKey",
            "providerType",
            "installStrategy",
            "expectedArtifacts",
            "fallbackProviderIds",
            "version",
            "modelId",
            "lastError"
          ]
        }
      },
      "runs": {
        "item": {
          "required": [
            "moduleId",
            "status",
            "warnings",
            "artifactIds",
            "findingIds"
          ],
          "optional": [
            "runId",
            "jobId",
            "requestId",
            "startedAt",
            "completedAt",
            "error"
          ]
        }
      },
      "results": {
        "item": {
          "required": [
            "moduleId",
            "phase",
            "status",
            "providerIds",
            "toolIds",
            "summary",
            "blockers",
            "warnings",
            "signals",
            "artifacts",
            "metrics",
            "timing",
            "runMeta"
          ],
          "optional": [
            "titleKey",
            "summaryKey",
            "requiredToolIds",
            "confidence",
            "sourceSignature"
          ]
        }
      },
      "export": {
        "required": ["items"],
        "optional": ["lastGeneratedAt"]
      }
    },
    "subtitleAnalysis": {
      "required": [
        "workspace",
        "discovery",
        "entries",
        "activeEntryId",
        "edit",
        "analysis",
        "export"
      ],
      "workspace": {
        "required": ["mode", "drafts", "selection"],
        "optional": ["lastError", "lastActionAt", "lastImportAt"]
      },
      "discovery": {
        "required": ["status", "scope", "items", "selectedCandidateIds", "totalCandidateCount"],
        "optional": ["lastError", "lastRunAt", "lastDownloadAt"]
      },
      "entries": {
        "item": {
          "required": [
            "id",
            "sourceType",
            "status",
            "fileName",
            "path",
            "format",
            "createdAt"
          ],
          "optional": [
            "sourceUrl",
            "language",
            "publishedAt",
            "durationSeconds",
            "isShort",
            "warnings",
            "metadata"
          ]
        }
      },
      "edit": {
        "required": ["presetId", "recipe", "preview", "outputs"],
        "optional": ["lastError", "lastActionAt"]
      },
      "analysis": {
        "required": ["status", "summaryCards", "findings", "warnings", "moduleResults"],
        "optional": ["lastRunAt", "sourceSelection"]
      },
      "export": {
        "required": ["items"],
        "optional": ["lastGeneratedAt"]
      }
    },
    "process": {
      "required": ["records"],
