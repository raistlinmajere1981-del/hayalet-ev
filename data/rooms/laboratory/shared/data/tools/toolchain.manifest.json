{
  "version": 1,
  "roomId": "laboratory",
  "tools": {
    "yt-dlp": {
      "displayName": "yt-dlp",
      "installDirName": "yt-dlp",
      "stageSupport": {
        "source": "required",
        "edit": "unsupported",
        "profile": "unsupported",
        "process": "unsupported",
        "report": "unsupported"
      },
      "releaseProvider": {
        "type": "github-release",
        "owner": "yt-dlp",
        "repo": "yt-dlp",
        "releaseUrl": "https://github.com/yt-dlp/yt-dlp/releases/latest"
      },
      "probe": {
        "args": ["--version"],
        "versionRegex": "(\\d{4}\\.\\d{2}\\.\\d{2}(?:\\.[0-9]+)?)"
      },
      "assets": {
        "linux-x64": {
          "assetMatch": "^yt-dlp_linux$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "linux-arm64": {
          "assetMatch": "^yt-dlp_linux_aarch64$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "linux-musl-x64": {
          "assetMatch": "^yt-dlp_musllinux$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "darwin-x64": {
          "assetMatch": "^yt-dlp_macos$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "darwin-arm64": {
          "assetMatch": "^yt-dlp_macos$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "win32-x64": {
          "assetMatch": "^yt-dlp\\.exe$",
          "archive": "none",
          "executableName": "yt-dlp.exe"
        },
        "win32-arm64": {
          "assetMatch": "^yt-dlp_arm64\\.exe$",
          "archive": "none",
          "executableName": "yt-dlp.exe"
        }
      }
    },
    "ffmpeg": {
      "displayName": "FFmpeg",
      "installDirName": "ffmpeg",
      "stageSupport": {
        "source": "required",
        "edit": "required",
        "profile": "required",
        "process": "required",
        "report": "unsupported"
      },
      "releaseProvider": {
        "type": "github-release",
        "owner": "yt-dlp",
        "repo": "FFmpeg-Builds",
        "releaseUrl": "https://github.com/yt-dlp/FFmpeg-Builds/releases/latest"
      },
      "probe": {
        "args": ["-version"],
        "versionRegex": "ffmpeg version\\s+([^\\s]+)"
      },
      "assets": {
        "linux-x64": {
          "assetMatch": "^ffmpeg-master-latest-linux64-gpl\\.tar\\.xz$",
          "archive": "tar.xz",
          "executableName": "ffmpeg",
          "companionExecutables": ["ffprobe"]
        },
        "linux-arm64": {
          "assetMatch": "^ffmpeg-master-latest-linuxarm64-gpl\\.tar\\.xz$",
          "archive": "tar.xz",
          "executableName": "ffmpeg",
          "companionExecutables": ["ffprobe"]
        },
        "win32-x64": {
          "assetMatch": "^ffmpeg-master-latest-win64-gpl\\.zip$",
          "archive": "zip",
          "executableName": "ffmpeg.exe",
          "companionExecutables": ["ffprobe.exe"]
        },
        "win32-arm64": {
          "assetMatch": "^ffmpeg-master-latest-winarm64-gpl\\.zip$",
          "archive": "zip",
          "executableName": "ffmpeg.exe",
          "companionExecutables": ["ffprobe.exe"]
        }
      }
    },
    "whisper.cpp": {
      "displayName": "Whisper.cpp",
      "installDirName": "whisper-cpp",
      "stageSupport": {
        "source": "unsupported",
        "edit": "unsupported",
        "profile": "optional",
        "process": "optional",
        "report": "unsupported"
      },
      "releaseProvider": {
        "type": "github-release",
        "owner": "ggml-org",
        "repo": "whisper.cpp",
        "releaseUrl": "https://github.com/ggml-org/whisper.cpp/releases/latest"
      },
      "probe": {
        "args": ["--help"],
        "versionRegex": "v?(\\d+\\.\\d+\\.\\d+)"
      },
      "assets": {
        "win32-x64": {
          "assetMatch": "^whisper-bin-x64\\.zip$",
          "archive": "zip",
          "executableName": "whisper-cli.exe"
        }
      }
    },
    "opensmile": {
      "displayName": "openSMILE",
      "installDirName": "opensmile",
      "availability": "system-command",
      "stageSupport": {
        "source": "unsupported",
        "edit": "unsupported",
        "profile": "optional",
        "process": "optional",
        "report": "unsupported"
      },
      "probe": {
        "args": ["-h"],
        "versionRegex": "(?:openSMILE|SMILExtract)[^\\d]*(\\d+(?:\\.\\d+)+)"
      },
      "systemCommand": {
        "executableName": "SMILExtract",
        "setupHint": "Install openSMILE on the host system so the SMILExtract binary is available on PATH, then refresh this tool from settings."
      }
    },
    "yamnet": {
      "displayName": "YAMNet",
      "installDirName": "yamnet",
      "availability": "system-command",
      "stageSupport": {
        "source": "unsupported",
        "edit": "unsupported",
        "profile": "optional",
        "process": "optional",
        "report": "unsupported"
      },
      "probe": {
        "args": [
          "-c",
          "import tensorflow as tf, tensorflow_hub as hub, scipy, numpy; print(tf.__version__)"
        ],
        "versionRegex": "(\\d+(?:\\.\\d+)+)"
      },
      "systemCommand": {
        "executableName": "python3",
        "setupHint": "Install python3 packages tensorflow, tensorflow_hub, numpy, and scipy so the room-local YAMNet helper can run, then refresh this tool from settings."
      }
    },
    "librosa": {
      "displayName": "librosa",
      "installDirName": "librosa",
      "availability": "system-command",
      "stageSupport": {
        "source": "unsupported",
        "edit": "unsupported",
        "profile": "optional",
        "process": "optional",
        "report": "unsupported"
      },
      "probe": {
        "args": [
          "-c",
          "import librosa, numpy, scipy; print(librosa.__version__)"
        ],
        "versionRegex": "(\\d+(?:\\.\\d+)+)"
      },
      "systemCommand": {
        "executableName": "python3",
        "setupHint": "Install python3 packages librosa, numpy, and scipy so the room-local music analysis helpers can run, then refresh this tool from settings."
      }
    },
    "demucs": {
      "displayName": "Demucs",
      "installDirName": "demucs",
      "availability": "system-command",
      "stageSupport": {
        "source": "unsupported",
        "edit": "unsupported",
        "profile": "optional",
        "process": "optional",
        "report": "unsupported"
      },
      "probe": {
        "args": [
          "-c",
          "import demucs, importlib.metadata; print(importlib.metadata.version('demucs'))"
        ],
        "versionRegex": "(\\d+(?:\\.\\d+)+)"
      },
      "systemCommand": {
        "executableName": "python3",
        "setupHint": "Install the demucs Python package so the prepared source-separation runtime can be enabled, then refresh this tool from settings."
      }
    },
    "essentia": {
      "displayName": "Essentia",
      "installDirName": "essentia",
      "availability": "system-command",
      "stageSupport": {
        "source": "unsupported",
        "edit": "unsupported",
        "profile": "optional",
        "process": "optional",
        "report": "unsupported"
      },
      "probe": {
        "args": [
          "-c",
          "import essentia, importlib.metadata; print(importlib.metadata.version('essentia'))"
        ],
        "versionRegex": "(\\d+(?:\\.\\d+)+)"
      },
      "systemCommand": {
        "executableName": "python3",
        "setupHint": "Install the essentia Python package so the prepared tonal fallback can be enabled, then refresh this tool from settings."
      }
    },
    "pyaudioanalysis": {
      "displayName": "pyAudioAnalysis",
      "installDirName": "pyaudioanalysis",
      "availability": "system-command",
      "stageSupport": {
        "source": "unsupported",
        "edit": "unsupported",
        "profile": "optional",
        "process": "optional",
        "report": "unsupported"
      },
      "probe": {
        "args": [
          "-c",
          "from pyAudioAnalysis import audioSegmentation as aS; import hmmlearn, sklearn, scipy, numpy; print('pyAudioAnalysis')"
        ],
        "versionRegex": "(pyAudioAnalysis)"
      },
      "systemCommand": {
        "executableName": "python3",
        "setupHint": "Install pyAudioAnalysis plus its local runtime dependencies (numpy, scipy, scikit-learn, and hmmlearn) on the host system, then refresh this tool from settings."
      }
    }
  }
}
