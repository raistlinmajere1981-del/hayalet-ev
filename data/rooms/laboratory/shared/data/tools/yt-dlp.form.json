          "type": "toggle",
          "labelKey": "mediaAnalysis.source.youtubeForm.fields.writeSubtitles"
        },
        {
          "id": "writeAutoSubtitles",
          "type": "toggle",
          "labelKey": "mediaAnalysis.source.youtubeForm.fields.writeAutoSubtitles"
        },
        {
