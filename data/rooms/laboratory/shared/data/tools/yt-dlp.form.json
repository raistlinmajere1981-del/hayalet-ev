            { "value": "webm", "labelKey": "mediaAnalysis.source.youtubeForm.options.recode.webm" }
          ]
        },
        {
          "id": "audioFormat",
          "type": "select",
          "labelKey": "mediaAnalysis.source.youtubeForm.fields.audioFormat",
          "options": [
            { "value": "none", "labelKey": "mediaAnalysis.source.youtubeForm.options.audio.none" },
            { "value": "mp3", "labelKey": "mediaAnalysis.source.youtubeForm.options.audio.mp3" },
            { "value": "aac", "labelKey": "mediaAnalysis.source.youtubeForm.options.audio.aac" },
            { "value": "m4a", "labelKey": "mediaAnalysis.source.youtubeForm.options.audio.m4a" },
            { "value": "opus", "labelKey": "mediaAnalysis.source.youtubeForm.options.audio.opus" },
            { "value": "wav", "labelKey": "mediaAnalysis.source.youtubeForm.options.audio.wav" },
            { "value": "flac", "labelKey": "mediaAnalysis.source.youtubeForm.options.audio.flac" }
          ]
        },
        {
          "id": "audioQuality",
          "type": "select",
          "labelKey": "mediaAnalysis.source.youtubeForm.fields.audioQuality",
          "options": [
            { "value": "best", "labelKey": "mediaAnalysis.source.youtubeForm.options.audioQuality.best" },
            { "value": "0", "labelKey": "mediaAnalysis.source.youtubeForm.options.audioQuality.max" },
            { "value": "2", "labelKey": "mediaAnalysis.source.youtubeForm.options.audioQuality.high" },
            { "value": "5", "labelKey": "mediaAnalysis.source.youtubeForm.options.audioQuality.medium" },
            { "value": "7", "labelKey": "mediaAnalysis.source.youtubeForm.options.audioQuality.small" }
