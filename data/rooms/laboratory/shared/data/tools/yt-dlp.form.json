          "type": "select",
          "labelKey": "mediaAnalysis.source.youtubeForm.fields.captureMode",
          "options": [
            { "value": "video+audio", "labelKey": "mediaAnalysis.source.youtubeForm.options.captureMode.videoAudio" },
            { "value": "audio-only", "labelKey": "mediaAnalysis.source.youtubeForm.options.captureMode.audioOnly" },
            { "value": "video-only", "labelKey": "mediaAnalysis.source.youtubeForm.options.captureMode.videoOnly" }
          ]
        },
        {
          "id": "format",
          "type": "select",
          "labelKey": "mediaAnalysis.source.youtubeForm.fields.format",
          "options": [
            { "value": "bestvideo*+bestaudio/best", "labelKey": "mediaAnalysis.source.youtubeForm.options.format.best" },
            { "value": "best[height<=1080][ext=mp4]/best[height<=1080]/best", "labelKey": "mediaAnalysis.source.youtubeForm.options.format.mp4_1080" },
            { "value": "best[height<=720][ext=mp4]/best[height<=720]/best", "labelKey": "mediaAnalysis.source.youtubeForm.options.format.mp4_720" },
            { "value": "best[height<=480][ext=mp4]/best[height<=480]/best", "labelKey": "mediaAnalysis.source.youtubeForm.options.format.mp4_480" },
            { "value": "best[height<=360][ext=mp4]/best[height<=360]/worst[ext=mp4]/worst", "labelKey": "mediaAnalysis.source.youtubeForm.options.format.low" }
          ]
        },
        {
