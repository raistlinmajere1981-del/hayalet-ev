{
  "schemaVersion": 2,
  "id": "game-room",
  "name": "Game Room",
  "version": "2.1.0",
  "description": "A focused board-game room that now starts with a polished XOX duel against AI slot opponents.",
  "menu": {
    "label": "Game Room",
    "icon": "🎮",
    "order": 80
  },
  "runtime": {
    "uiEntry": "ui/index.html",
    "hostEntry": "host/index.js"
  },
  "defaultFeatureId": "xox",
  "i18n": {
    "baseDir": "i18n"
  },
  "scene": {
    "referenceSize": {
      "width": 1600,
      "height": 900
    },
    "roomBackgroundSrc": "assets/room-background.webp",
    "roomsHotspot": {
      "id": "game-room-door",
      "rect": {
        "leftPx": 726,
        "topPx": 244,
        "widthPx": 154,
        "heightPx": 318
      },
      "label": {
        "text": "Game Room"
      }
    },
    "backHotspot": {
      "id": "game-room-back",
      "rect": {
        "leftPx": 52,
        "topPx": 152,
        "widthPx": 156,
        "heightPx": 248
      },
      "label": {
        "text": "Corridor"
      }
    }
  },
  "features": [
    {
      "id": "xox",
      "name": "XOX",
      "description": "Three-in-a-row matches against the connected AI1 or AI2 slot.",
      "icon": "XO",
      "commandSpecs": [
        {
          "name": "GameRoomXoxStart",
          "description": "Start a new XOX match from the room UI.",
          "scope": "room-ui"
        },
        {
          "name": "GameRoomXoxReset",
          "description": "Reset the active XOX match state.",
          "scope": "room-ui"
        },
        {
          "name": "GameRoomXoxUserMove",
          "description": "Apply the user's XOX move from the room UI.",
          "scope": "room-ui"
        },
        {
          "name": "GameRoomXoxAiMove",
          "description": "Apply the AI move returned by the selected opponent slot.",
          "scope": "ai-slots"
        }
      ],
      "protocolSpecs": [
        {
          "key": "game-room-xox-user-start",
          "room": "game-room",
          "scenario": "xox-user-start",
          "title": "[START][GAME-ROOM][XOX][USER-FIRST]",
          "editable": true
        },
        {
          "key": "game-room-xox-ai-start",
          "room": "game-room",
          "scenario": "xox-ai-start",
          "title": "[START][GAME-ROOM][XOX][AI-FIRST]",
          "editable": true
        }
      ],
      "scene": {
        "hotspot": {
          "id": "game-room-xox",
          "rect": {
            "leftPx": 188,
            "topPx": 362,
            "widthPx": 446,
            "heightPx": 258
          },
          "label": {
            "text": "XOX"
          }
        },
        "view": {
          "id": "xox-closeup",
          "backgroundSrc": "assets/xox-view.webp",
          "transparentWindow": {
            "leftPct": 28.28,
            "topPct": 18.8,
            "widthPct": 43.59,
            "heightPct": 54.17
          }
        }
      }
    }
  ]
}
