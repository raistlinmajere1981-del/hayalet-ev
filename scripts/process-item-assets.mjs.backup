#!/usr/bin/env node
import { createRequire } from "node:module";
import path from "node:path";
import { fileURLToPath } from "node:url";
import fs from "fs-extra";
import { glob } from "glob";
import sharp from "sharp";
import { Jimp } from "jimp";
import { removeBackground } from "@imgly/background-removal-node";

const require = createRequire(import.meta.url);
const ENABLE_OPENCV = process.env.ASSET_ENABLE_OPENCV === "1";
let cv = null;
if (ENABLE_OPENCV) {
  process.env.OPENCV4NODEJS_DISABLE_AUTOBUILD = process.env.OPENCV4NODEJS_DISABLE_AUTOBUILD ?? "1";
  try {
    cv = require("@u4/opencv4nodejs");
  } catch {
    cv = null;
  }
}

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const ROOT = path.resolve(__dirname, "..");
const RAW_DIR = path.join(ROOT, "assets", "raw");
const DONE_DIR = path.join(RAW_DIR, "done");
const METADATA_FILE = path.join(ROOT, "assets", "metadata", "items.json");

function toSlug(name) {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "_")
    .replace(/^_+|_+$/g, "")
    .replace(/_{2,}/g, "_");
}

function sortBoxes(a, b) {
  if (Math.abs(a.y - b.y) > 16) return a.y - b.y;
  return a.x - b.x;
}

function detectBoxesWithOpenCv(imageBuffer) {
  if (!cv) return null;
  const mat = cv.imdecode(imageBuffer);
  const width = mat.cols;
  const height = mat.rows;
  const totalArea = Math.max(1, width * height);

  const gray =
    mat.channels === 4
      ? mat.cvtColor(cv.COLOR_BGRA2GRAY)
      : mat.channels === 3
        ? mat.cvtColor(cv.COLOR_BGR2GRAY)
        : mat;

  const blurred = gray.gaussianBlur(new cv.Size(5, 5), 0);
  const thresholded = blurred.threshold(0, 255, cv.THRESH_BINARY_INV + cv.THRESH_OTSU);
  const kernel = new cv.Mat(3, 3, cv.CV_8U, 1);
  const morphed = thresholded.morphologyEx(cv.MORPH_OPEN, kernel);
  const contours = morphed.findContours(cv.RETR_EXTERNAL, cv.CHAIN_APPROX_SIMPLE);

  const boxes = contours
    .map((contour) => contour.boundingRect())
    .filter(
      (rect) => rect.width > 8 && rect.height > 8 && (rect.width * rect.height) / totalArea > 0.001
    )
    .map((rect) => ({
      x: Math.max(0, rect.x),
      y: Math.max(0, rect.y),
      width: Math.min(width - rect.x, rect.width),
      height: Math.min(height - rect.y, rect.height),
    }))
    .sort(sortBoxes);

  if (boxes.length === 0) {
    return [{ x: 0, y: 0, width, height }];
  }
  return boxes;
}

async function detectBoxesFallback(imageBuffer, options = {}) {
  const alphaOnly = options.alphaOnly === true;
  const { data, info } = await sharp(imageBuffer)
    .ensureAlpha()
    .raw()
    .toBuffer({ resolveWithObject: true });
  const { width, height } = info;
  const totalArea = Math.max(1, width * height);
  const visited = new Uint8Array(width * height);
  const boxes = [];

  const isForeground = (x, y) => {
    const idx = (y * width + x) * 4;
    const r = data[idx];
    const g = data[idx + 1];
    const b = data[idx + 2];
    const a = data[idx + 3];
    if (alphaOnly) return a > 24;
    if (a <= 8) return false;
    return r < 245 || g < 245 || b < 245;
  };

  const queue = new Int32Array(width * height);
  for (let y = 0; y < height; y += 1) {
    for (let x = 0; x < width; x += 1) {
      const start = y * width + x;
      if (visited[start] === 1 || !isForeground(x, y)) {
        visited[start] = 1;
        continue;
      }

      let head = 0;
      let tail = 0;
      queue[tail++] = start;
      visited[start] = 1;
      let minX = x;
      let minY = y;
      let maxX = x;
      let maxY = y;
      let pixels = 0;

      while (head < tail) {
        const pos = queue[head++];
        const px = pos % width;
        const py = Math.floor(pos / width);
        pixels += 1;

        if (px < minX) minX = px;
        if (py < minY) minY = py;
        if (px > maxX) maxX = px;
        if (py > maxY) maxY = py;

        for (let oy = -1; oy <= 1; oy += 1) {
          for (let ox = -1; ox <= 1; ox += 1) {
            if (ox === 0 && oy === 0) continue;
            const nx = px + ox;
            const ny = py + oy;
            if (nx < 0 || ny < 0 || nx >= width || ny >= height) continue;
            const nextPos = ny * width + nx;
            if (visited[nextPos] === 1) continue;
            visited[nextPos] = 1;
            if (!isForeground(nx, ny)) continue;
            queue[tail++] = nextPos;
          }
        }
      }

      const boxWidth = maxX - minX + 1;
      const boxHeight = maxY - minY + 1;
      const areaRatio = (boxWidth * boxHeight) / totalArea;
      if (pixels >= 20 && boxWidth > 8 && boxHeight > 8 && areaRatio > 0.001) {
        boxes.push({
          x: minX,
          y: minY,
          width: boxWidth,
          height: boxHeight,
        });
      }
    }
  }

  boxes.sort(sortBoxes);
  if (boxes.length > 0) return boxes;
  return [{ x: 0, y: 0, width, height }];
}

async function detectBoxes(imageBuffer, options = {}) {
  const alphaOnly = options.alphaOnly === true;
  const openCvBoxes = alphaOnly ? null : detectBoxesWithOpenCv(imageBuffer);
  if (openCvBoxes && openCvBoxes.length > 0) return openCvBoxes;
  return detectBoxesFallback(imageBuffer, options);
}

async function toBuffer(result) {
  if (Buffer.isBuffer(result)) return result;
  if (result instanceof Uint8Array) return Buffer.from(result);
  if (result instanceof ArrayBuffer) return Buffer.from(result);
  if (typeof Blob !== "undefined" && result instanceof Blob) {
    return Buffer.from(await result.arrayBuffer());
  }
  throw new Error("Unsupported background removal output.");
}

async function removeBg(buffer) {
  try {
    const source = new Blob([buffer], { type: "image/png" });
    const output = await removeBackground(source, {
      output: {
        format: "image/png",
        quality: 1,
        type: "foreground",
      },
    });
    return { buffer: await toBuffer(output), removed: true };
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    console.warn(`[assets:process:items] Background removal fallback used: ${message}`);
    return { buffer: await sharp(buffer).ensureAlpha().png().toBuffer(), removed: false };
  }
}

async function trimWithAlpha(inputBuffer) {
  const image = await Jimp.read(inputBuffer);
  const { width, height, data } = image.bitmap;
  let minX = width;
  let minY = height;
  let maxX = -1;
  let maxY = -1;

  for (let y = 0; y < height; y += 1) {
    for (let x = 0; x < width; x += 1) {
      const idx = (y * width + x) * 4;
      const alpha = data[idx + 3];
      if (alpha > 8) {
        if (x < minX) minX = x;
        if (y < minY) minY = y;
        if (x > maxX) maxX = x;
        if (y > maxY) maxY = y;
      }
    }
  }

  if (maxX < minX || maxY < minY) return inputBuffer;

  const left = minX;
  const top = minY;
  const widthBox = maxX - minX + 1;
  const heightBox = maxY - minY + 1;

  return sharp(inputBuffer)
    .extract({ left, top, width: widthBox, height: heightBox })
    .png()
    .toBuffer();
}

async function normalize(buffer, outputPath, target, outputFormat) {
  const targetWidth = target.width || 512;
  const targetHeight = target.height || 512;
  const fitMode = target.fit || "contain";
  const paddingVal = target.padding || 0;
  
  const pipeline = sharp(buffer)
    .ensureAlpha()
    .resize(targetWidth, targetHeight, {
      fit: fitMode,
      position: "center",
      background: { r: 0, g: 0, b: 0, alpha: 0 },
    });
  
  if (outputFormat === "jpeg" || outputFormat === "jpg") {
    await pipeline.jpeg({ quality: 95 }).toFile(outputPath);
  } else if (outputFormat === "png") {
    await pipeline.png().toFile(outputPath);
  } else {
    // Default to webp
    await pipeline.webp({ quality: 95, alphaQuality: 100, effort: 6, smartSubsample: true }).toFile(outputPath);
  }
}

function normalizeTagList(tags) {
  return tags
    .map((tag) => String(tag).trim().toLowerCase())
    .filter(Boolean)
    .map((tag) => tag.replace(/[^a-z0-9]+/g, "_"))
    .filter(Boolean);
}

function parseSourceManifest(inputPath, manifestRaw) {
  if (!manifestRaw || typeof manifestRaw !== "object") {
    throw new Error(`Invalid JSON manifest near ${path.basename(inputPath)}.`);
  }
  const source = typeof manifestRaw.source === "string" ? manifestRaw.source.trim() : "";
  const expectedSource = path.basename(inputPath);
  if (source !== expectedSource) {
    throw new Error(`Manifest source mismatch for ${expectedSource}. Expected source="${expectedSource}".`);
  }
  const outputDirRaw = typeof manifestRaw.outputDir === "string" ? manifestRaw.outputDir.trim() : "";
  if (outputDirRaw === "") {
    throw new Error(`Manifest outputDir missing for ${expectedSource}.`);
  }
  const outputDirAbs = path.resolve(ROOT, outputDirRaw);
  if (!outputDirAbs.startsWith(ROOT + path.sep) && outputDirAbs !== ROOT) {
    throw new Error(`Manifest outputDir must stay within project root for ${expectedSource}.`);
  }
  
  // Parse target dimensions
  const target = manifestRaw.target || {};
  const width = Number(target.width) || 512;
  const height = Number(target.height) || 512;
  const fit = String(target.fit || "contain");
  const padding = Number(target.padding) || 0;
  
  // Parse output format
  const outputFormat = String(manifestRaw.outputFormat || "webp");
  
  if (!Array.isArray(manifestRaw.items) || manifestRaw.items.length === 0) {
    throw new Error(`Manifest items missing for ${expectedSource}.`);
  }

  const normalized = manifestRaw.items.map((item, i) => {
    const index = Number(item?.index);
    const id = typeof item?.id === "string" ? item.id.trim() : "";
    const name = typeof item?.name === "string" ? item.name.trim() : "";
    const tags = Array.isArray(item?.tags) ? normalizeTagList(item.tags) : [];
    if (!Number.isInteger(index) || index < 0) {
      throw new Error(`Invalid item.index at ${expectedSource} items[${i}].`);
    }
    if (!id.startsWith("item_")) {
      throw new Error(`Invalid item.id at ${expectedSource} items[${i}]. Must start with "item_".`);
    }
    if (toSlug(id.replace(/^item_/, "")) === "") {
      throw new Error(`Invalid item.id at ${expectedSource} items[${i}].`);
    }
    if (toSlug(name) === "") {
      throw new Error(`Invalid item.name at ${expectedSource} items[${i}].`);
    }
    if (tags.length === 0) {
      throw new Error(`Invalid item.tags at ${expectedSource} items[${i}].`);
    }
    return { index, id, name, tags };
  });

  const sorted = [...normalized].sort((a, b) => a.index - b.index);
  for (let i = 0; i < sorted.length; i += 1) {
    if (sorted[i].index !== i) {
      throw new Error(`Manifest indexes must be contiguous from 0 for ${expectedSource}.`);
    }
  }
  return { outputDirRaw, outputDirAbs, items: sorted, width, height, fit, padding, outputFormat };
}

async function processImage(inputPath, metadata, context) {
  const sourceFileName = path.basename(inputPath);
  const manifestPath = path.join(path.dirname(inputPath), `${path.basename(inputPath, path.extname(inputPath))}.json`);
  if (!(await fs.pathExists(manifestPath))) {
    throw new Error(`Missing required manifest: ${path.relative(ROOT, manifestPath)} for ${sourceFileName}.`);
  }
  const manifest = parseSourceManifest(inputPath, await fs.readJson(manifestPath));
  await fs.ensureDir(manifest.outputDirAbs);
  if (!context.clearedDirs.has(manifest.outputDirAbs)) {
    await fs.emptyDir(manifest.outputDirAbs);
    context.clearedDirs.add(manifest.outputDirAbs);
  }

  const imageBuffer = await fs.readFile(inputPath);
  const fullRemoved = await removeBg(imageBuffer);
  let boxes = await detectBoxes(fullRemoved.buffer, { alphaOnly: true });
  if (boxes.length <= 1 && !fullRemoved.removed) {
    boxes = await detectBoxes(imageBuffer, { alphaOnly: false });
  }
  if (boxes.length !== manifest.items.length) {
    throw new Error(
      `Detected ${boxes.length} objects in ${sourceFileName} but manifest declares ${manifest.items.length} items.`
    );
  }

  for (let index = 0; index < boxes.length; index += 1) {
    const box = boxes[index];
    const manifestItem = manifest.items[index];
    const extension = manifest.outputFormat === "jpeg" || manifest.outputFormat === "jpg" ? "jpg" : manifest.outputFormat;
    const fileName = `${toSlug(manifestItem.name)}.${extension}`;
    const outputPath = path.join(manifest.outputDirAbs, fileName);
    const fileKey = path.normalize(outputPath);
    if (context.generatedFiles.has(fileKey)) {
      throw new Error(`Duplicate output file name detected: ${path.relative(ROOT, outputPath)}`);
    }
    context.generatedFiles.add(fileKey);
    const relFile = path.relative(ROOT, outputPath).replace(/\\/g, "/");

    const sourceForCrop = fullRemoved.removed ? fullRemoved.buffer : imageBuffer;
    const cropped = await sharp(sourceForCrop)
      .extract({
        left: box.x,
        top: box.y,
        width: box.width,
        height: box.height,
      })
      .png()
      .toBuffer();

    const noBg = fullRemoved.removed ? { buffer: cropped } : await removeBg(cropped);
    const trimmed = await trimWithAlpha(noBg.buffer);
    await normalize(trimmed, outputPath, manifest, manifest.outputFormat);

    metadata.push({
      id: manifestItem.id,
      file: relFile,
      type: "item",
      tags: manifestItem.tags,
    });
  }

  // Archive processed image and manifest to done folder
  const timestamp = new Date().toISOString().replace(/[:.]/g, "-").split("T")[0];
  const archiveName = `${path.basename(inputPath, path.extname(inputPath))}_${timestamp}`;
  const archiveDir = path.join(DONE_DIR, archiveName);
  await fs.ensureDir(archiveDir);
  await fs.copy(inputPath, path.join(archiveDir, sourceFileName));
  await fs.copy(manifestPath, path.join(archiveDir, path.basename(manifestPath)));
}
  const manifest = parseSourceManifest(inputPath, await fs.readJson(manifestPath));
  await fs.ensureDir(manifest.outputDirAbs);
  if (!context.clearedDirs.has(manifest.outputDirAbs)) {
    await fs.emptyDir(manifest.outputDirAbs);
    context.clearedDirs.add(manifest.outputDirAbs);
  }

  const imageBuffer = await fs.readFile(inputPath);
  const fullRemoved = await removeBg(imageBuffer);
  let boxes = await detectBoxes(fullRemoved.buffer, { alphaOnly: true });
  if (boxes.length <= 1 && !fullRemoved.removed) {
    boxes = await detectBoxes(imageBuffer, { alphaOnly: false });
  }
  if (boxes.length !== manifest.items.length) {
    throw new Error(
      `Detected ${boxes.length} objects in ${sourceFileName} but manifest declares ${manifest.items.length} items.`
    );
  }

  for (let index = 0; index < boxes.length; index += 1) {
    const box = boxes[index];
    const manifestItem = manifest.items[index];
    const fileName = `${toSlug(manifestItem.name)}.webp`;
    const outputPath = path.join(manifest.outputDirAbs, fileName);
    const fileKey = path.normalize(outputPath);
    if (context.generatedFiles.has(fileKey)) {
      throw new Error(`Duplicate output file name detected: ${path.relative(ROOT, outputPath)}`);
    }
    context.generatedFiles.add(fileKey);
    const relFile = path.relative(ROOT, outputPath).replace(/\\/g, "/");

    const sourceForCrop = fullRemoved.removed ? fullRemoved.buffer : imageBuffer;
    const cropped = await sharp(sourceForCrop)
      .extract({
        left: box.x,
        top: box.y,
        width: box.width,
        height: box.height,
      })
      .png()
      .toBuffer();

    const noBg = fullRemoved.removed ? { buffer: cropped } : await removeBg(cropped);
    const trimmed = await trimWithAlpha(noBg.buffer);
    await normalize(trimmed, outputPath);

    metadata.push({
      id: manifestItem.id,
      file: relFile,
      type: "item",
      tags: manifestItem.tags,
    });
  }
}

async function main() {
  await fs.ensureDir(RAW_DIR);
  await fs.ensureDir(path.dirname(METADATA_FILE));

  const files = await glob("**/*.{png,jpg,jpeg,webp,bmp,tif,tiff}", {
    cwd: RAW_DIR,
    absolute: true,
    nodir: true,
  });

  const metadata = [];
  const context = { clearedDirs: new Set(), generatedFiles: new Set() };
  for (const filePath of files) {
    await processImage(filePath, metadata, context);
  }

  await fs.writeJson(METADATA_FILE, metadata, { spaces: 2 });

  console.log(
    JSON.stringify(
      {
        processedFiles: files.length,
        exportedItems: metadata.length,
        outputDirs: [...context.clearedDirs].map((dir) => path.relative(ROOT, dir)),
        metadataFile: path.relative(ROOT, METADATA_FILE),
      },
      null,
      2
    )
  );
}

main().catch((error) => {
  console.error(`[assets:process:items] ${error instanceof Error ? error.message : String(error)}`);
  process.exit(1);
});
